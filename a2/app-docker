# python runtime
FROM python:3.13-slim

WORKDIR /app
RUN useradd --create-home --shell /bin/bash appuser

COPY app_requirements.txt .
RUN pip install --no-cache-dir -r app_requirements.txt

COPY acp_server/ ./acp_server/
COPY bedrock_gemma/ ./bedrock_gemma/
COPY --from=build ./static

USER appuser

EXPOSE 7331 7332

WORKDIR /app/acp_server
CMD ["python", "-u", "acp_websocket.py", "--host", "0.0.0.0", "--verbose"]